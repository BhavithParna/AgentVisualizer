{
  "name": "agent-visualizer",
  "productName": "Agent Visualizer",
  "version": "1.0.0",
  "description": "A live desktop view of your Claude Code agents and subagents: who is running, on which model, and what they are doing.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "web": "node server.js",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.agentvisualizer.app",
    "files": ["main.js", "server.js", "index.html", "vendor/**", "build/icon.png"],
    "directories": { "buildResources": "build" },
    "mac": { "target": "dmg", "category": "public.app-category.developer-tools" },
    "linux": { "target": "AppImage", "category": "Development" }
  }
}
